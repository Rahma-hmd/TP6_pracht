---
import Layout from "../../../layouts/Layout.astro";
import penguins from "../../../assets/penguins.json";

const sexes = [
    ...new Set(
        penguins
            .filter((penguin) => penguin.sex != null)
            .map((penguin) => penguin.sex as string),
    ),
];
---

<Layout>
    <main class="min-h-screen bg-[#b0c4de] px-6 py-10">
        <div class="max-w-5xl mx-auto">
            <a href="/penguins/" class="font-semibold">
                ← Retour aux Penguins
            </a>

            <h1 class="text-4xl font-bold mt-6 mb-3">Penguins par sexe</h1>

            <p class="mb-8">
                Choisissez un sexe pour afficher les données correspondantes.
            </p>

            <div class="bg-white rounded-2xl shadow-md p-6">
                <div class="flex flex-wrap gap-3">
                    {
                        sexes.map((sex) => (
                            <a
                                href={`/penguins/sex/${sex}/`}
                                class="btn btn-primary"
                            >
                                {sex}
                            </a>
                        ))
                    }
                </div>
            </div>
        </div>
    </main>
</Layout>
